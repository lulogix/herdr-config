#!/usr/bin/env bash
# Human/agent-facing entrypoint.
#
# Prefers dist/cli.js, the same compiled output Herdr runs. Falls back to running
# TypeScript from source only when no build exists and the local Node can do it.
set -euo pipefail

# Follow symlinks: this script is commonly called through ~/.local/bin/pane-name,
# and dirname of the symlink points at the wrong plugin.
self=${BASH_SOURCE[0]}
while [ -L "$self" ]; do
  link=$(readlink "$self")
  case "$link" in
    /*) self=$link ;;
    *) self=$(cd "$(dirname "$self")" && pwd)/$link ;;
  esac
done
dir=$(cd "$(dirname "$self")/.." && pwd)

if ! command -v node >/dev/null 2>&1; then
  echo "pane-name: node is required (install Node 18+)" >&2
  exit 127
fi

if [ -f "$dir/dist/cli.js" ]; then
  exec node "$dir/dist/cli.js" "$@"
fi

read -r major minor <<EOF2
$(node -p 'const [a, b] = process.versions.node.split("."); a + " " + b')
EOF2

if [ "$major" -lt 22 ]; then
  echo "pane-name: no build found and Node $major cannot run TypeScript." >&2
  echo "Build it once: (cd $dir && npx tsc -p tsconfig.build.json)" >&2
  exit 1
fi

flags=()
if [ "$major" -eq 22 ] && [ "$minor" -lt 18 ]; then
  flags=(--experimental-strip-types)
fi

exec node ${flags[@]+"${flags[@]}"} "$dir/src/cli.ts" "$@"
